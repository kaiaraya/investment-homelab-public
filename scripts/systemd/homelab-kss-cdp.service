After=network-online.target graphical-session.target homelab-gateway.service
Wants=network-online.target homelab-gateway.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/home/araya-sawasdichai/Documents/antigravity/InvestmentHomelab
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
UnsetEnvironment=LINE_ADMIN_USER_ID
ExecStart=/home/araya-sawasdichai/Documents/antigravity/InvestmentHomelab/.venv/bin/python scripts/broker_cdp/session_daemon.py kss 180 --resume-only
